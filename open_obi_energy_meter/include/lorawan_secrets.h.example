#pragma once
// ============================================================================
//  LoRaWAN OTAA SECRETS -- TEMPLATE
// ----------------------------------------------------------------------------
//  Copy this file to lorawan_secrets.h (git-ignored) and fill in the real
//  credentials from the municipal ChirpStack device registration. The DevEUI
//  is NOT taken from here -- it's derived at runtime from the fleet convention
//  (see obi_deveui.h); only JoinEUI + AppKey are used from this file.
//  Network is LoRaWAN 1.0.x -> only AppKey is used (no NwkKey).
// ============================================================================
#include <Arduino.h>

// 8-byte JoinEUI / AppEUI (often all-zero on ChirpStack)
const uint64_t JoinEUI = 0x0000000000000000;

// 16-byte AppKey (32 hex chars from ChirpStack's device registration)
const uint8_t AppKey[] = {
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};
